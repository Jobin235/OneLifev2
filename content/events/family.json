      { "id": "buy_it", "label": "Offer to buy it", "requires": { "field": "money.liquid", "op": ">=", "value": 1800000 }, "outcomes": [ { "id": "bought", "text": "You took on the loan and a house you don't live in. {parent.they} cried, briefly, and denied it.", "historyLine": "You bought your parents' house.", "effects": [ { "op": "money", "delta": -1800000 }, { "op": "debt", "delta": 6100000 }, { "op": "asset_add", "assetId": "childhood_home" }, { "op": "stat", "stat": "happiness", "delta": 11 }, { "op": "stat", "stat": "charm", "delta": 6 }, { "op": "relationship", "target": "parent", "dimension": "affection", "delta": 20 }, { "op": "remember", "target": "parent", "factKey": "you_saved_the_house", "line": "You bought the house so {parent.they} wouldn't have to sell it.", "weight": 88 }, { "op": "flag", "key": "owns_childhood_home", "value": true } ] } ] },
