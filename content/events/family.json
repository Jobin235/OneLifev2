      { "id": "go_to_b", "label": "Go to {kid_b}'s thing", "outcomes": [ { "id": "went_b", "text": "{kid_b} spotted you from the stage and forgot a line. It was the best thing that happened all year.", "historyLine": "You went to {kid_b}'s school play.", "effects": [ { "op": "relationship", "target": "kid_b", "dimension": "closeness", "delta": 16 }, { "op": "relationship", "target": "kid_b", "dimension": "affection", "delta": 12 }, { "op": "relationship", "target": "kid_a", "dimension": "closeness", "delta": -6 }, { "op": "stat", "stat": "happiness", "delta": 7 } ] } ] },
      { "id": "split_it", "label": "Send {partner} to one, take the other", "requires": { "field": "has.partner", "op": "==", "value": true }, "outcomes": [ { "id": "split", "text": "You split it. Both of them noticed which one got you.", "historyLine": "You split the Saturday between the kids.", "effects": [ { "op": "relationship", "target": "kid_a", "dimension": "closeness", "delta": 8 }, { "op": "relationship", "target": "kid_b", "dimension": "closeness", "delta": -2 }, { "op": "relationship", "target": "partner", "dimension": "dependence", "delta": 6 } ] } ] },
      { "id": "work", "label": "Work. It's a Saturday in November.", "outcomes": [ { "id": "worked", "text": "You worked. Nobody made a scene, and both of them added it to a list you have never been shown.", "historyLine": "You worked through a Saturday you'd promised them.", "effects": [ { "op": "career_performance", "delta": 6 }, { "op": "relationship", "target": "kid_a", "dimension": "closeness", "delta": -9 }, { "op": "relationship", "target": "kid_b", "dimension": "closeness", "delta": -9 }, { "op": "stat", "stat": "happiness", "delta": -6 }, { "op": "remember", "target": "kid_b", "factKey": "you_missed_it", "line": "You worked instead. {kid_b} stopped mentioning things after that.", "weight": 70 } ] } ] }
